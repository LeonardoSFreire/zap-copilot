{
  "manifest_version": 3,
  "name": "Zap Copilot — IA de vendas para WhatsApp Web",
  "short_name": "Zap Copilot",
  "version": "0.5.0",
  "description": "Analisa conversas, agenda follow-ups e sugere respostas seguindo o seu script de vendas. Roda local, com a sua chave da OpenAI ou Groq.",
  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://api.openai.com/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/content.js"],
      "css": ["src/panel.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "src/options.html",
  "action": {
    "default_title": "Zap Copilot",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
